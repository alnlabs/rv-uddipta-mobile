EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_KEY=your_publishable_key
EXPO_PUBLIC_API_URL=http://localhost:4800
# Phone Google clients. Leave blank in Expo Go; the website sign-in is used.
# Web client id is the one already on the website. iOS client id is the new phone client.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
