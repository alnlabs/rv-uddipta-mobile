{
  "expo": {
    "name": "RV Uddiipta",
    "slug": "rv-uddipta",
    "scheme": "rv-uddipta",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "color": "#059669"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "RV Uddiipta uses your photos when you add a picture to a community post."
        }
      ]
    ],
    "experiments": {
      "tsconfigPaths": true
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.alnlabs.rvuddipta"
    },
    "android": {
      "package": "com.alnlabs.rvuddipta",
      "adaptiveIcon": {
        "backgroundColor": "#854225",
        "foregroundImage": "./assets/icon.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/icon.png"
    }
  }
}
